<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.sync.mapper.UnitMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="io.github.sync.po.Unit">
        <id column="id" property="id"/>
        <result column="org_id" property="orgId"/>
        <result column="dwdm" property="dwdm"/>
        <result column="dwmc" property="dwmc"/>
        <result column="dwywmc" property="dwywmc"/>
        <result column="dwdz" property="dwdz"/>
        <result column="dwyzbm" property="dwyzbm"/>
        <result column="dwzgbmm" property="dwzgbmm"/>
        <result column="dwjj" property="dwjj"/>
        <result column="tyshxydm" property="tyshxydm"/>
        <result column="xzqhm" property="xzqhm"/>
        <result column="last_sequence" property="lastSequence"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, org_id, dwdm, dwmc, dwywmc, dwdz, dwyzbm, dwzgbmm, dwjj, tyshxydm, xzqhm, last_sequence, create_time, update_time
    </sql>

</mapper>
